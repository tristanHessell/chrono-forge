{
  "name": "browser-card-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky && npm run css:types",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "messages": "formatjs extract 'src/**/*.{ts,tsx}' --ignore '**/*.test.*' --out-file src/i18n/en.json --format simple",
    "messages:check": "node scripts/check-message-catalog.ts",
    "css:types": "node scripts/generate-css-types.ts",
    "typecheck": "npm run css:types && tsc -b",
    "lint": "eslint . && npm run lint:package && npm run lint:css && npm run lint:md",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:package": "npmPkgJsonLint .",
    "lint:staged": "lint-staged",
    "lint:fix": "eslint . --fix",
    "spellcheck": "cspell --no-progress",
    "pretest": "npm run css:types",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:simulation": "vitest run --config vitest.simulation.config.ts",
    "format": "npm run lint:fix && prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "check": "npm run lint && npm run format:check && npm run spellcheck && npm test && npm run build"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "types": {
        "feat": {
          "description": "A new feature",
          "title": "Features"
        },
        "fix": {
          "description": "A bug fix",
          "title": "Bug Fixes"
        },
        "docs": {
          "description": "Documentation only changes",
          "title": "Documentation"
        },
        "style": {
          "description": "Changes that do not affect code meaning",
          "title": "Styles"
        },
        "refactor": {
          "description": "A code change that neither fixes a bug nor adds a feature",
          "title": "Code Refactoring"
        },
        "perf": {
          "description": "A code change that improves performance",
          "title": "Performance Improvements"
        },
        "test": {
          "description": "Adding or correcting tests",
          "title": "Tests"
        },
        "build": {
          "description": "Changes to the build system or dependencies",
          "title": "Builds"
        },
        "ci": {
          "description": "Changes to CI configuration",
          "title": "Continuous Integration"
        },
        "chore": {
          "description": "Other changes that do not modify source or test files",
          "title": "Chores"
        }
      }
    }
  },
  "dependencies": {
    "boardgame.io": "0.50.2",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "12.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@formatjs/cli": "6.16.32",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/lodash.camelcase": "4.3.9",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "5.0.5",
    "commitizen": "4.3.2",
    "cspell": "10.4.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-formatjs": "8.1.2",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "lodash.camelcase": "4.3.0",
    "markdownlint-cli2": "0.24.0",
    "npm-package-json-lint": "11.0.0",
    "playwright": "1.64.1",
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.10",
    "source-map-js": "1.2.2",
    "stylelint": "17.16.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.2",
    "stylelint-plugin-defensive-css": "2.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
