{
  "name": "browser-card-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && npm run lint:package",
    "lint:package": "npmPkgJsonLint .",
    "lint:staged": "lint-staged",
    "lint:fix": "eslint . --fix",
    "spellcheck": "cspell --no-progress",
    "test": "vitest run",
    "test:simulation": "vitest run --config vitest.simulation.config.ts",
    "format": "npm run lint:fix && prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "check": "npm run lint && npm run format:check && npm run spellcheck && npm test && npm run build"
  },
  "dependencies": {
    "boardgame.io": "0.50.2",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "12.1.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "cspell": "10.4.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-package-json-lint": "11.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
